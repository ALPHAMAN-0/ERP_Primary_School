@{ ViewBag.Title = "Change Password"; }
<div class="page-head"><h1 class="page-title">Change Password</h1></div>

@using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { @class = "card narrow" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(false, "", new { @class = "flash flash-bad" })
    <label>Current password<input name="currentPassword" type="password" class="form-control" required /></label>
    <label>New password<input name="newPassword" type="password" class="form-control" minlength="8" required /></label>
    <label>Confirm new password<input name="confirmPassword" type="password" class="form-control" minlength="8" required /></label>
    <div class="form-actions"><button type="submit" class="btn btn-primary">Change password</button></div>
}
