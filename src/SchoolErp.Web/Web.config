<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration for the ASP.NET MVC 5 application (§2), targeting the MonsterASP
  free tier (§3).

  Everything an institution needs to change to go live is in this one file:
  the connection string, the SMTP provider, and the backup credential path.
-->
<configuration>

  <configSections>
    <section name="entityFramework"
             type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
             requirePermission="false" />
  </configSections>

  <connectionStrings>
    <!--
      MultipleActiveResultSets is off deliberately: it masks N+1 query patterns
      that a 256 MB host cannot afford (§3). Every query in the services states
      its Includes instead.
    -->
    <add name="SchoolErpContext"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=SchoolErp;Integrated Security=True;MultipleActiveResultSets=False;App=SchoolErp"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />

    <add key="Institution:Name" value="Shahjalal School &amp; College" />
    <add key="Institution:NameBn" value="শাহজালাল স্কুল অ্যান্ড কলেজ" />
    <add key="Institution:Eiin" value="132907" />

    <!--
      §12 — SMS. Left empty on purpose.

      Bangladesh bulk SMS runs about ৳0.30 a message with no free tier; at ~2,500
      guardians and two sends a month that is roughly ৳18,000 a year, an order of
      magnitude above the hosting bill. The queue, the audience calculation and
      the cost projection are all built; only the paid provider is missing, and
      buying one is the institution's decision. Set a provider name here to
      activate the channel, and implement the call in NotificationService.SendSms.
    -->
    <add key="Sms:Provider" value="" />
    <add key="Sms:ApiKey" value="" />
    <add key="Sms:SenderId" value="" />

    <!--
      §15 — nightly backup to Google Drive, kept off the hosting provider so an
      outage on one does not take out the other. Point this at a Google service
      account JSON credential to enable the upload.
    -->
    <add key="Backup:GoogleCredentialPath" value="" />
    <add key="Backup:StagingPath" value="" />
    <add key="Backup:RetentionDays" value="30" />

    <!-- §14 — uploads live on the filesystem, never in the database. -->
    <add key="Storage:UploadPath" value="~/App_Data/uploads" />
    <add key="Storage:MaxUploadBytes" value="2097152" />
  </appSettings>

  <system.web>
    <!-- §2 — .NET Framework 4.8. -->
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8"
                 maxRequestLength="4096"
                 enableVersionHeader="false" />

    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login"
             timeout="480"
             slidingExpiration="true"
             requireSSL="true"
             cookieless="UseCookies"
             protection="All" />
    </authentication>

    <!-- Never leak a stack trace to a parent looking at a fee page. -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error">
      <error statusCode="404" redirect="~/Error/NotFound" />
      <error statusCode="403" redirect="~/Error/Forbidden" />
    </customErrors>

    <sessionState mode="InProc" timeout="480" cookieless="false" />

    <!-- §13 — Unicode end to end, so Bangla survives the round trip. -->
    <globalization requestEncoding="utf-8"
                   responseEncoding="utf-8"
                   fileEncoding="utf-8"
                   culture="en-GB"
                   uiCulture="en-GB" />

    <machineKey compatibilityMode="Framework45" validation="HMACSHA256" decryption="AES" />

    <pages controlRenderingCompatibilityVersion="4.0">
      <namespaces>
        <add namespace="System.Web.Helpers" />
        <add namespace="System.Web.Mvc" />
        <add namespace="System.Web.Mvc.Ajax" />
        <add namespace="System.Web.Mvc.Html" />
        <add namespace="System.Web.Optimization" />
        <add namespace="System.Web.Routing" />
        <add namespace="SchoolErp.Web.ViewModels" />
        <add namespace="SchoolErp.Domain.Common" />
      </namespaces>
    </pages>
  </system.web>

  <system.net>
    <!--
      §12 — the email provider.

      Development uses a personal Gmail SMTP; production switches to Brevo's free
      tier (300/day, built for transactional sending). That switch is this block
      and nothing else — the application talks to SmtpClient, never to a provider.
    -->
    <mailSettings>
      <smtp deliveryMethod="Network" from="noreply@shahjalalsc.edu.bd">
        <network host="smtp-relay.brevo.com"
                 port="587"
                 enableSsl="true"
                 userName=""
                 password="" />
      </smtp>
    </mailSettings>
  </system.net>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />

    <modules>
      <remove name="FormsAuthentication" />
      <add name="FormsAuthentication" type="System.Web.Security.FormsAuthenticationModule" />
    </modules>

    <httpProtocol>
      <customHeaders>
        <!-- Strip the headers that tell an attacker exactly what to target. -->
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>

    <staticContent>
      <!-- §13 — Bangla webfonts, correctly typed and cached. -->
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="4194304" />
      </requestFiltering>
    </security>

    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*"
           type="System.Web.Handlers.TransferRequestHandler"
           preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>

  <entityFramework>
    <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlConnectionFactory, EntityFramework" />
    <providers>
      <provider invariantName="System.Data.SqlClient"
                type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
    </providers>
  </entityFramework>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-5.2.9.0" newVersion="5.2.9.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="WebGrease" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-1.6.5135.21930" newVersion="1.6.5135.21930" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

</configuration>
